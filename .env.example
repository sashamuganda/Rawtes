# GitHub OAuth App Client ID
VITE_GITHUB_CLIENT_ID=your_client_id_here

# CORS Proxy URL (Required for browser-based auth)
# Set up using instructions in PROXY_SETUP.md
VITE_PROXY_URL=https://your-proxy-worker.workers.dev

# Cloudflare Worker Proxy URL (e.g. https://your-worker.your-name.workers.dev)
VITE_PROXY_URL=
